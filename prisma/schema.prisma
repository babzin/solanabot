datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RiskTier {
  SAFE
  RISK
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  ALERTED
  SNIPED
  SKIPPED_SECURITY
  SKIPPED_IMPACT
  SKIPPED_DUPLICATE
  ERROR
}

model TrackedWallet {
  id                String      @id @default(cuid())
  address           String      @unique
  label             String?
  tier              RiskTier
  strategyProfile   String
  winRate           Float
  profitFactor      Float
  totalTrades       Int
  medianHoldSeconds Int
  netSolProfit      Float       @default(0.0)
  isActive          Boolean     @default(true)
  lastScoredAt      DateTime    @default(now())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  trades            TradeLog[]

  @@index([tier, isActive])
  @@index([winRate])
}

model TradeLog {
  id                String       @id @default(cuid())
  signature         String       @unique
  walletAddress     String
  tokenMint         String
  tokenSymbol       String?
  side              TradeSide
  solAmount         Float
  tokenAmount       Float
  entryMarketCap    Float?
  status            TradeStatus  @default(ALERTED)
  rejectionReason   String?
  executedAt        DateTime
  createdAt         DateTime     @default(now())

  wallet            TrackedWallet? @relation(fields: [walletAddress], references: [address])

  @@index([walletAddress])
  @@index([tokenMint])
  @@index([createdAt])
}

model UserPreference {
  id                  String         @id @default(cuid())
  telegramUserId      String         @unique
  telegramChatId      String?        // DM chat ID for direct routing
  username            String?
  receiveSafeAlerts   Boolean        @default(true)
  receiveRiskAlerts   Boolean        @default(true)
  minWinRate          Float          @default(0.60)
  autoSnipeEnabled    Boolean        @default(false)
  autoSnipeSolAmount  Float          @default(0.1)
  fixedTradeSizeUsd   Float          @default(10.00) // Fixed $10 USD rule
  maxSlippagePercent  Float          @default(15.0)
  priorityFeeLamports Int            @default(100000) // Default 0.0001 SOL (Turbo)
  takeProfitPercent   Float          @default(100.0) // 2X Principal De-Risk
  trailingStopPct     Float          @default(35.0)  // 35% Pullback from Peak
  isMembershipActive  Boolean        @default(true)

  // Encrypted Wallet Storage
  solanaWallet        String?        // Public Base58 address
  encryptedSecret     String?        // AES-256-GCM ciphertext
  encryptionIv        String?        // IV in hex
  encryptionTag       String?        // Auth tag in hex

  positions           UserPosition[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model UserPosition {
  id                 String         @id @default(cuid())
  userId             String
  user               UserPreference @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenMint          String
  tokenSymbol        String
  entryPriceUsd      Float
  currentPriceUsd    Float
  peakPriceUsd       Float
  solInvested        Float
  initialTokens      Float
  remainingTokens    Float
  status             String         @default("OPEN") // OPEN, PARTIAL_TP_2X, CLOSED
  exitReason         String?
  realizedSolProfit  Float          @default(0.0)
  createdAt          DateTime       @default(now())
  closedAt           DateTime?

  @@unique([userId, tokenMint])
  @@index([tokenMint, status])
}

model EarlyTrendingToken {
  id                  String   @id @default(cuid())
  tokenMint           String   @unique
  tokenSymbol         String
  tokenName           String
  pairAddress         String?
  dexUrl              String?
  imageUrl            String?
  pairCreatedAt       BigInt?
  ageMinutes          Int?
  liquidityUsd        Float?
  volume1h            Float?
  holderCount         Int?
  top20Pct            Float?
  devHoldingPct       Float?
  xUrl                String?
  webUrl              String?
  tgUrl               String?
  entryPriceUsd       Float
  entryMarketCap      Float
  peakPriceUsd        Float
  lowestPriceUsd      Float
  lastAlertedPriceUsd Float
  lastMilestonePct    Int      @default(0) // Highest +50% milestone reached (e.g. 50, 100, 150...)
  lastDipMilestonePct Int      @default(0) // Lowest -50% dip milestone reached (e.g. -50)
  status              String   @default("ACTIVE") // ACTIVE, GRADUATED, STOPPED
  alertDate           String   // Date string "YYYY-MM-DD" for strict quota
  whaleSolAmount      Float?   // Whale buy amount in SOL if detected
  dailyQuotaIndex     Int      // Number for this day
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([alertDate])
  @@index([status])
}


    "@fastify/sensible": "^5.5.0",
    "@prisma/client": "^5.18.0",
    "@solana/web3.js": "^1.95.3",
    "@types/localtunnel": "^2.0.4",
    "@types/node": "^20.14.12",
    "@types/node-telegram-bot-api": "^0.64.6",
    "axios": "^1.7.4",
    "bs58": "^6.0.0",
    "bullmq": "^5.12.9",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "localtunnel": "^2.0.2",

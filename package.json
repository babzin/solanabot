{
  "name": "solana-copy-trading-bot",
  "version": "1.0.0",
  "description": "Autonomous Solana Smart-Money Intelligence & Copy-Trade Alert Bot",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "bot": "tsx src/run_bot.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "discover": "tsx src/cron/walletDiscovery.ts",
    "discover:safe": "tsx src/cron/walletDiscovery.ts --profile=safe",
    "discover:risk": "tsx src/cron/walletDiscovery.ts --profile=risk",
    "demo": "tsx src/demo.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "keywords": [
    "solana",
    "copy-trading",
    "smart-money",
    "helius",
    "telegram-bot",
    "pumpfun",
    "raydium"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/sensible": "^5.5.0",
    "@prisma/client": "^5.18.0",
    "@solana/web3.js": "^1.95.3",
    "axios": "^1.7.4",
    "bs58": "^6.0.0",
    "bullmq": "^5.12.9",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "node-telegram-bot-api": "^0.66.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/node-telegram-bot-api": "^0.64.6",
    "prisma": "^5.18.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}

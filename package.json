  "description": "Autonomous Solana Smart-Money Intelligence & Copy-Trade Alert Bot",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --dns-result-order=ipv4first node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "bot": "node --dns-result-order=ipv4first node_modules/tsx/dist/cli.mjs src/index.ts",
    "build": "tsc",
    "postinstall": "prisma generate",
    "start": "node --dns-result-order=ipv4first dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "tunnel": "tsx scripts/tunnel.ts"
  },
  "keywords": [
    "solana",
    "copy-trading",
    "smart-money",
    "helius",
    "telegram-bot",
    "pumpfun",
